# ===== Fichier d'exemple : copie-le sous le nom ".env" puis remplis les valeurs =====
# Port sur lequel le serveur écoute
PORT=5000
# Adresse de la base MongoDB (local ou MongoDB Atlas : voir le README)
MONGO_URI=mongodb://127.0.0.1:27017/exos
# Mot de passe secret qui signe les jetons de connexion (mets une longue phrase aléatoire)
JWT_SECRET=change-moi-par-une-longue-phrase-secrete
# Adresse de l'interface React autorisée à appeler l'API (en ligne : l'adresse Vercel/Netlify)
CLIENT_URL=http://localhost:5173
# Dossier où sont rangés les fichiers envoyés (photos, exercices, corrections)
UPLOAD_DIR=uploads

# Compte administrateur créé par la commande "npm run seed"
ADMIN_NAME=Administrateur
ADMIN_PHONE=+24107000000
ADMIN_PASSWORD=ChangeMoi123

# Prix de l'abonnement en FCFA (30 jours)
PRICE_FCFA=3000
# "simulated" = paiement fictif pour tester ; "live" = vrais paiements Mobile Money
PAYMENT_MODE=simulated
# Mot secret que l'opérateur envoie avec ses confirmations de paiement (webhook)
WEBHOOK_SECRET=change-moi-aussi
# Identifiants Airtel Money (fournis par Airtel après ouverture du compte marchand)
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# Identifiants Moov Money (fournis par Moov Africa Gabon)
MOOV_BASE_URL=
MOOV_API_KEY=

# ===== SMS (mot de passe oublié) =====
# "console" = le code s'affiche dans le terminal (test) ; "twilio" = vrais SMS
SMS_PROVIDER=console
# Nom d'expéditeur affiché (lettres, 11 caractères maximum). Évite INFO, Verify, Notify.
SMS_SENDER=EXOS
# Indicatif du pays (Gabon : 241)
SMS_COUNTRY_CODE=241
# Mettre "true" si les SMS n'arrivent pas : retire le 0 au début des numéros locaux
SMS_STRIP_LEADING_ZERO=false
# Identifiants Twilio (console Twilio > Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Facultatif : identifiant d'un « Messaging Service » Twilio (remplace SMS_SENDER)
TWILIO_MESSAGING_SERVICE_SID=

# ===== Stockage des fichiers =====
# "local" = disque du serveur (développement) ; "s3" = stockage en ligne (production)
STORAGE_DRIVER=local
# Réglages S3 (Cloudflare R2, AWS S3, Backblaze B2…)
S3_BUCKET=
S3_REGION=auto
# Adresse du service. R2 : https://IDENTIFIANT_DE_COMPTE.r2.cloudflarestorage.com (vide pour AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
