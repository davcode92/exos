# ===== Copie ce fichier sous le nom ".env" =====
# Adresse du serveur. LAISSER VIDE en développement (Vite relaie vers localhost:5000).
# En ligne : mets l'adresse du serveur, par exemple https://exos-api.onrender.com
VITE_API_URL=
# "true" affiche un bouton de paiement fictif (à mettre à false en production)
VITE_SIMULATE=true
# Numéro WhatsApp des réclamations (format international sans + ni espaces). Vide = numéro par défaut du code.
VITE_WHATSAPP_NUMBER=
